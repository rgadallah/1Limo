---
import { business } from '../data/business';
import { withBase } from '../lib/site';

const navLinks = [
  { href: '/services/', label: 'Services' },
  { href: '/fleet/', label: 'Fleet' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/about/', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-bg/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-8">
    <a
      href={withBase("/")}
      class="font-display text-2xl font-semibold tracking-wide text-text transition-colors hover:text-accent"
      aria-label={`${business.name} home`}
    >
      <!-- Placeholder wordmark — swap for the real logo, see src/assets/logo.README.md -->
      1<span class="text-accent">Limo</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={withBase(link.href)}
            class="text-sm font-medium tracking-wide text-muted transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a
        href={business.phoneHref}
        class="flex items-center gap-2 text-sm font-semibold text-text transition-colors hover:text-accent"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4 text-accent" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h.75a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a11.25 11.25 0 0 1-5.052-5.052l1.293-.97a1.125 1.125 0 0 0 .417-1.173L8.963 3.852a1.125 1.125 0 0 0-1.091-.852H6.5A2.25 2.25 0 0 0 4.25 5.25v1.5Z" />
        </svg>
        {business.phone}
      </a>
      <a
        href={withBase("/contact/")}
        class="rounded-sm bg-accent px-5 py-2.5 text-sm font-semibold tracking-wide text-bg transition-colors hover:bg-accent-light"
      >
        Get a Quote
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center rounded-sm border border-border p-2 text-text lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="hidden flex-col gap-1 border-t border-border bg-bg px-6 py-4 lg:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={withBase(link.href)}
          class="rounded-sm px-2 py-3 text-base font-medium text-text transition-colors hover:bg-surface hover:text-accent"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={business.phoneHref}
      class="mt-2 rounded-sm border border-accent px-2 py-3 text-center text-base font-semibold text-accent"
    >
      Call {business.phone}
    </a>
    <a
      href={withBase("/contact/")}
      class="rounded-sm bg-accent px-2 py-3 text-center text-base font-semibold text-bg"
    >
      Get a Quote
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    mobileNav?.classList.toggle('hidden', isOpen);
    mobileNav?.classList.toggle('flex', !isOpen);
  });
</script>
