---
import { testimonials } from '../data/business';
---

<section class="bg-surface py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6 md:px-8">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">
        Client Experiences
      </p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-text md:text-4xl">
        Trusted by executives, wedding parties, and frequent flyers
      </h2>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3">
      {
        testimonials.map((testimonial, index) => (
          <div
            data-reveal
            style={`transition-delay: ${index * 100}ms`}
            class="flex flex-col rounded-sm border border-border bg-bg p-8"
          >
            <div class="flex gap-1 text-accent" aria-hidden="true">
              {Array.from({ length: testimonial.rating }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.956a1 1 0 0 0 .95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 0 0-.363 1.118l1.287 3.955c.3.922-.755 1.688-1.539 1.118l-3.367-2.446a1 1 0 0 0-1.176 0l-3.367 2.446c-.783.57-1.838-.196-1.539-1.118l1.287-3.955a1 1 0 0 0-.363-1.118L2.063 9.383c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 0 0 .95-.69l1.285-3.956Z" />
                </svg>
              ))}
            </div>
            <p class="mt-5 flex-1 text-[0.95rem] leading-relaxed text-text/90">
              &ldquo;{testimonial.quote}&rdquo;
            </p>
            <div class="mt-6 border-t border-border pt-4">
              <p class="text-sm font-semibold text-text">{testimonial.author}</p>
              <p class="text-sm text-muted">{testimonial.context}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
