---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTABand from '../../components/CTABand.astro';
import { business } from '../../data/business';
import { unsplashUrl } from '../../lib/unsplash';

const standards = [
  {
    title: 'Licensed & insured',
    body: 'Every vehicle and chauffeur operates under full commercial licensing and insurance, maintained and verified on an ongoing basis.',
  },
  {
    title: 'Professionally trained chauffeurs',
    body: 'Background-checked, trained in defensive driving and professional conduct, and held to a dress and etiquette standard — not just a license.',
  },
  {
    title: 'Fleet maintained on a fixed schedule',
    body: 'Every vehicle is inspected and detailed before it leaves the garage, and serviced on a strict maintenance schedule regardless of mileage.',
  },
  {
    title: 'A dispatcher, not a call center',
    body: "When you call, you reach someone who knows the DFW area and can make a real decision — not a script.",
  },
];
---

<Layout
  title="About 1Limo | Chauffeured Transportation in Dallas-Fort Worth"
  description="1Limo provides licensed, insured, professionally chauffeured transportation across Dallas-Fort Worth — built on reliability, discretion, and an immaculate fleet."
  path="/about/"
>
  <section class="relative overflow-hidden bg-bg">
    <div class="absolute inset-0">
      <Image
        src={unsplashUrl('1519085360753-af0119f7cbe7', 1920, 1100)}
        width={1920}
        height={1100}
        alt="Professional in a dark suit, arms crossed"
        class="h-full w-full object-cover opacity-40"
        priority
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/85 to-bg/50" />
    </div>
    <div class="relative mx-auto max-w-7xl px-6 pb-16 pt-28 md:px-8 md:pb-20 md:pt-36">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.25em] text-accent">About Us</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold leading-[1.1] text-text sm:text-5xl">
        {business.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-text/85">
        1Limo provides licensed, insured, professionally chauffeured transportation across Dallas-Fort Worth —
        built on reliability, discretion, and a fleet held to one uncompromising standard.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 md:px-8">
      <h2 data-reveal class="font-display text-3xl font-semibold text-text">More than a limousine company</h2>
      <p data-reveal style="transition-delay: 50ms" class="mt-5 leading-relaxed text-muted">
        A limousine company gets you from one place to another. We think the job is bigger than that — it's making
        sure the transportation is the one part of your day you never have to think twice about. That means a
        chauffeur who's already tracking your flight before you land, a vehicle that's spotless before you ever see
        it, and a dispatcher who picks up the phone and actually solves the problem.
      </p>
      <p data-reveal style="transition-delay: 100ms" class="mt-4 leading-relaxed text-muted">
        We serve executives, wedding parties, event planners, and everyday travelers across Dallas, Fort Worth,
        Plano, and the surrounding DFW Metroplex — for a single airport run or years of standing corporate travel.
      </p>
    </div>
  </section>

  <section class="bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      <div data-reveal class="max-w-2xl">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">Our Standard</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-text md:text-4xl">What "premium" actually means here</h2>
      </div>
      <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          standards.map((s, i) => (
            <div data-reveal style={`transition-delay: ${i * 100}ms`} class="border-t-2 border-accent/50 pt-5">
              <h3 class="font-display text-lg font-semibold text-text">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 text-center md:px-8">
      <h2 data-reveal class="font-display text-3xl font-semibold text-text">{business.hours.label}</h2>
      <p data-reveal style="transition-delay: 50ms" class="mt-4 leading-relaxed text-muted">
        Serving {business.serviceAreaSummary}. Call anytime — a real reservation specialist answers, day or night.
      </p>
    </div>
  </section>

  <CTABand />
</Layout>
