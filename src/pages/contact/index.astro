---
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { business } from '../../data/business';
---

<Layout
  title="Contact 1Limo | Get a Quote for DFW Chauffeured Transportation"
  description="Request a quote or call 1Limo's 24/7 reservation line for chauffeured transportation across Dallas-Fort Worth, Plano, and the DFW Metroplex."
  path="/contact/"
>
  <section class="border-b border-border bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 text-center md:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">
        Contact &amp; Reservations
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-text sm:text-5xl">Get a Quote</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Call our 24/7 reservation line for immediate assistance, or send your trip details below and a reservation
        specialist will confirm within minutes.
      </p>
      <a
        href={business.phoneHref}
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-sm bg-accent px-8 py-4 text-base font-semibold text-bg transition-colors hover:bg-accent-light"
      >
        Call {business.phone}
      </a>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-14 px-6 md:px-8 lg:grid-cols-[1fr_1.3fr] lg:gap-20">
      <div data-reveal>
        <h2 class="font-display text-2xl font-semibold text-text">Reservation Details</h2>
        <dl class="mt-8 space-y-6 text-sm">
          <div>
            <dt class="font-semibold uppercase tracking-widest text-accent">Phone</dt>
            <dd class="mt-1.5">
              <a href={business.phoneHref} class="text-lg text-text hover:text-accent">{business.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold uppercase tracking-widest text-accent">Email</dt>
            <dd class="mt-1.5">
              <a href={`mailto:${business.email}`} class="text-lg text-text hover:text-accent">{business.email}</a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold uppercase tracking-widest text-accent">Availability</dt>
            <dd class="mt-1.5 text-text">{business.hours.label}</dd>
          </div>
          <div>
            <dt class="font-semibold uppercase tracking-widest text-accent">Service Area</dt>
            <dd class="mt-1.5 text-text">{business.serviceAreaSummary}</dd>
          </div>
        </dl>
      </div>

      <div data-reveal style="transition-delay: 75ms">
        <LeadForm />
      </div>
    </div>
  </section>
</Layout>
