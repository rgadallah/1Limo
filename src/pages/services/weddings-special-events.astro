---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import LeadForm from '../../components/LeadForm.astro';
import CTABand from '../../components/CTABand.astro';
import { business } from '../../data/business';
import { getService } from '../../data/services';
import { serviceSchema, faqSchema } from '../../lib/schema';
import { unsplashUrl } from '../../lib/unsplash';
import { withBase } from '../../lib/site';

const service = getService('weddings-special-events')!;

const features = [
  {
    title: 'A timeline we build with you',
    body: 'Ceremony, photos, reception, send-off — we map every pickup in advance so the day never waits on transportation.',
  },
  {
    title: 'A spotless vehicle for the photos',
    body: 'Every vehicle is detailed before it leaves the garage, inside and out, because it ends up in more photos than you expect.',
  },
  {
    title: 'Room for the whole party',
    body: 'From an intimate sedan for the couple to a stretch limousine or sprinter van for the full wedding party.',
  },
  {
    title: 'A chauffeur who reads the room',
    body: 'Professional, unobtrusive, and ready to adjust if the timeline shifts — because wedding days always shift.',
  },
];

const faqs = [
  {
    question: 'How far in advance should we book wedding transportation?',
    answer:
      'We recommend booking 2-3 months ahead for peak wedding season (spring and fall), though we can often accommodate shorter notice — call to check availability for your date.',
  },
  {
    question: 'Can you accommodate a detailed, multi-stop timeline?',
    answer:
      'Yes — send us your full day-of timeline (getting-ready location, ceremony, photo locations, reception, send-off) and we build the transportation schedule around it.',
  },
  {
    question: 'What vehicle is best for our wedding party size?',
    answer:
      'It depends on your party size and style — see our Fleet page for options from executive sedans to stretch limousines and sprinter vans, or call and we\'ll help you choose.',
  },
];
---

<Layout title={service.metaTitle} description={service.metaDescription} path="/services/weddings-special-events/">
  <Fragment slot="schema">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        serviceSchema({ name: 'Weddings & Special Events', description: service.metaDescription, path: '/services/weddings-special-events/' })
      )}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema(faqs))} />
  </Fragment>

  <section class="relative overflow-hidden bg-bg">
    <div class="absolute inset-0">
      <Image
        src={unsplashUrl('1618418721668-0d1f72aa4bab', 1920)}
        width={1920}
        height={1100}
        alt="Polished black luxury car parked for a wedding"
        class="h-full w-full object-cover opacity-40"
        priority
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/85 to-bg/50" />
    </div>
    <div class="relative mx-auto max-w-7xl px-6 pb-16 pt-28 md:px-8 md:pb-20 md:pt-36">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a href={withBase("/")} class="hover:text-accent">Home</a>
        <span class="mx-2">/</span>
        <a href={withBase("/services/")} class="hover:text-accent">Services</a>
        <span class="mx-2">/</span>
        <span class="text-text/70">Weddings &amp; Special Events</span>
      </nav>
      <h1 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.1] text-text sm:text-5xl">
        Wedding &amp; Special Event Transportation
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-text/85">{service.heroBlurb}</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a href={business.phoneHref} class="flex items-center justify-center gap-2 rounded-sm bg-accent px-7 py-3.5 text-base font-semibold text-bg transition-colors hover:bg-accent-light">
          Call {business.phone}
        </a>
        <a href="#quote" class="flex items-center justify-center rounded-sm border border-text/30 px-7 py-3.5 text-base font-semibold text-text transition-colors hover:border-accent hover:text-accent">
          Get a Quote
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 md:px-8">
      <h2 data-reveal class="font-display text-3xl font-semibold text-text">
        One less thing to coordinate on your wedding day
      </h2>
      <p data-reveal style="transition-delay: 50ms" class="mt-5 leading-relaxed text-muted">
        Wedding transportation isn't just a car — it's a piece of the day's timeline that has to work perfectly
        alongside the photographer, the venue, and everyone's schedule. We build that timeline with you in advance,
        so on the day itself, the only thing you need to think about is getting married.
      </p>
      <p data-reveal style="transition-delay: 100ms" class="mt-4 leading-relaxed text-muted">
        We serve venues across Dallas, Fort Worth, and Plano, for the couple, the wedding party, and out-of-town
        guests who need a ride from the hotel.
      </p>
    </div>
  </section>

  <section class="bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      <div data-reveal class="max-w-2xl">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">What's Included</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-text md:text-4xl">Built for wedding-day timing</h2>
      </div>
      <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((f, i) => (
            <div data-reveal style={`transition-delay: ${i * 100}ms`} class="border-t-2 border-accent/50 pt-5">
              <h3 class="font-display text-lg font-semibold text-text">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 md:px-8">
      <h2 data-reveal class="font-display text-3xl font-semibold text-text">Wedding transportation FAQ</h2>
      <div class="mt-10 divide-y divide-border border-t border-border">
        {
          faqs.map((faq, i) => (
            <details data-reveal style={`transition-delay: ${i * 60}ms`} class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-medium text-text">
                {faq.question}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 flex-shrink-0 text-accent transition-transform group-open:rotate-45" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 5a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 10 5Z" clip-rule="evenodd" />
                </svg>
              </summary>
              <p class="mt-3 leading-relaxed text-muted">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand heading="Planning a wedding or special event?" subheading="Tell us your date and timeline — we'll help you plan the transportation around it." />

  <section id="quote" class="py-20 md:py-28">
    <div class="mx-auto max-w-2xl px-6 md:px-8">
      <div data-reveal class="text-center">
        <h2 class="font-display text-3xl font-semibold text-text">Request Wedding Transportation</h2>
        <p class="mt-3 text-muted">Share your date and details — a reservation specialist will confirm within minutes.</p>
      </div>
      <LeadForm defaultService="Weddings & Special Events" class="mt-10" />
    </div>
  </section>
</Layout>
