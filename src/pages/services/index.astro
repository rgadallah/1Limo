---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTABand from '../../components/CTABand.astro';
import { services } from '../../data/services';
import { unsplashUrl } from '../../lib/unsplash';
import { withBase } from '../../lib/site';
---

<Layout
  title="Chauffeured Transportation Services | 1Limo Dallas-Fort Worth"
  description="Airport transfers, corporate travel, weddings, casino trips, accessible transportation, and hourly chauffeur service across Dallas-Fort Worth."
  path="/services/"
>
  <section class="border-b border-border bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 text-center md:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">
        Our Services
      </p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-text sm:text-5xl">
        A Chauffeured Service for Every Occasion
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Every service below runs on the same standard: professional chauffeurs, immaculate vehicles, and a pickup
        that's on time whether it's 6am at DFW or midnight after a wedding reception.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, index) => (
            <a
              href={withBase(`/services/${service.slug}/`)}
              data-reveal
              style={`transition-delay: ${(index % 3) * 100}ms`}
              class="group block overflow-hidden rounded-sm border border-border bg-surface transition-colors hover:border-accent/60"
            >
              <div class="relative h-48 overflow-hidden">
                <Image
                  src={unsplashUrl(service.imageId, 800, 533)}
                  width={800}
                  height={533}
                  alt={service.imageAlt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/10 to-transparent" />
              </div>
              <div class="p-6">
                <h2 class="font-display text-lg font-semibold text-text group-hover:text-accent">
                  {service.name}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">{service.heroBlurb}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand />
</Layout>
