---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTABand from '../../components/CTABand.astro';
import { fleet } from '../../data/fleet';
import { unsplashUrl } from '../../lib/unsplash';
---

<Layout
  title="Our Fleet | Executive Sedans, SUVs & Limousines | 1Limo"
  description="Explore the 1Limo fleet — executive sedans, luxury SUVs, stretch limousines, and sprinter vans serving Dallas-Fort Worth."
  path="/fleet/"
>
  <section class="border-b border-border bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 text-center md:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">Our Fleet</p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-text sm:text-5xl">
        A Vehicle for Every Trip
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Every vehicle in our fleet is inspected and detailed before it leaves the garage — no exceptions. Below are
        the categories we run; call to confirm exact availability for your date.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-6xl space-y-20 px-6 md:px-8">
      {
        fleet.map((vehicle, index) => (
          <div
            data-reveal
            class={`grid items-center gap-10 lg:grid-cols-2 lg:gap-16 ${index % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}
          >
            <div class="overflow-hidden rounded-sm">
              <Image
                src={unsplashUrl(vehicle.imageId, 1000)}
                width={1000}
                height={750}
                alt={vehicle.imageAlt}
                class="h-full w-full object-cover"
              />
            </div>
            <div>
              <h2 class="font-display text-2xl font-semibold text-text md:text-3xl">{vehicle.name}</h2>
              <p class="mt-4 leading-relaxed text-muted">{vehicle.description}</p>
              <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-border pt-6 text-sm sm:grid-cols-3">
                <div>
                  <dt class="font-semibold uppercase tracking-widest text-accent">Passengers</dt>
                  <dd class="mt-1 text-text">{vehicle.passengers}</dd>
                </div>
                <div>
                  <dt class="font-semibold uppercase tracking-widest text-accent">Luggage</dt>
                  <dd class="mt-1 text-text">{vehicle.luggage}</dd>
                </div>
                <div class="col-span-2 sm:col-span-1">
                  <dt class="font-semibold uppercase tracking-widest text-accent">Best For</dt>
                  <dd class="mt-1 text-text">{vehicle.bestFor}</dd>
                </div>
              </dl>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <CTABand heading="Not sure which vehicle fits your trip?" subheading="Call our dispatch line and we'll help you choose the right one." />
</Layout>
