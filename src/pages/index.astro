---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import CTABand from '../components/CTABand.astro';
import { business, serviceAreas } from '../data/business';
import { services } from '../data/services';
import { unsplashUrl } from '../lib/unsplash';

const trustPoints = [
  'Licensed & Insured',
  '24/7 Availability',
  'Flight Tracking Included',
  'Professionally Trained Chauffeurs',
];

const differentiators = [
  {
    title: 'Chauffeurs, not drivers',
    body: 'Every chauffeur is professionally trained, background-checked, and dressed to represent your standards — not a rideshare app with a nicer car.',
  },
  {
    title: 'Flight tracking, built in',
    body: 'We monitor your flight in real time, so a delay on your end never means a wait at the curb — or a missed pickup.',
  },
  {
    title: 'A fleet that stays immaculate',
    body: 'Every vehicle is inspected and detailed before it leaves the garage. No exceptions, no excuses.',
  },
  {
    title: 'One point of contact',
    body: 'A dedicated reservation line, not a call center — reach a real person who knows DFW and knows your trip.',
  },
];
---

<Layout
  title="1Limo | Luxury Chauffeured Transportation in Dallas-Fort Worth"
  description="Premium chauffeured transportation across Dallas-Fort Worth — airport transfers, corporate travel, weddings, and events. Licensed, insured, available 24/7."
  path="/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-bg">
    <div class="absolute inset-0">
      <Image
        src={unsplashUrl('1522255272218-7ac5249be344', 1920)}
        width={1920}
        height={1200}
        alt="Black luxury sedan parked outside an upscale venue at dusk"
        class="h-full w-full object-cover opacity-70"
        priority
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/70 to-bg/30"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-bg/90 via-bg/40 to-transparent"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 pb-20 pt-28 md:px-8 md:pb-28 md:pt-36 lg:pt-44">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.25em] text-accent">
        Dallas &middot; Fort Worth &middot; Plano &middot; DFW Metroplex
      </p>
      <h1 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.1] text-text sm:text-5xl md:text-6xl">
        {business.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-text/85">
        Airport transfers, corporate travel, weddings, and events — chauffeured across North Texas with precision, discretion, and an unmistakable level of care.
      </p>

      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a
          href={business.phoneHref}
          class="flex items-center justify-center gap-2 rounded-sm bg-accent px-7 py-3.5 text-base font-semibold text-bg transition-colors hover:bg-accent-light"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h.75a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a11.25 11.25 0 0 1-5.052-5.052l1.293-.97a1.125 1.125 0 0 0 .417-1.173L8.963 3.852a1.125 1.125 0 0 0-1.091-.852H6.5A2.25 2.25 0 0 0 4.25 5.25v1.5Z" />
          </svg>
          Call {business.phone}
        </a>
        <a
          href="/contact/"
          class="flex items-center justify-center rounded-sm border border-text/30 px-7 py-3.5 text-base font-semibold text-text transition-colors hover:border-accent hover:text-accent"
        >
          Get a Quote
        </a>
      </div>

      <ul class="mt-14 flex flex-wrap gap-x-8 gap-y-3 border-t border-text/10 pt-8 text-sm text-text/75">
        {
          trustPoints.map((point) => (
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-accent" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services overview -->
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      <div data-reveal class="max-w-2xl">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">
          Our Services
        </p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-text md:text-4xl">
          A dedicated vehicle and chauffeur for every occasion
        </h2>
        <p class="mt-4 text-muted">
          From a flight touching down at DFW to a wedding recessional in Fort Worth, every service is built around the same standard.
        </p>
      </div>

      <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, index) => (
            <a
              href={`/services/${service.slug}/`}
              data-reveal
              style={`transition-delay: ${(index % 3) * 100}ms`}
              class="group block overflow-hidden rounded-sm border border-border bg-surface transition-colors hover:border-accent/60"
            >
              <div class="relative h-48 overflow-hidden">
                <Image
                  src={unsplashUrl(service.imageId, 800)}
                  width={800}
                  height={533}
                  alt={service.imageAlt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/10 to-transparent"></div>
              </div>
              <div class="p-6">
                <h3 class="font-display text-lg font-semibold text-text group-hover:text-accent">
                  {service.name}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{service.cardBlurb}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="bg-surface py-24 md:py-32">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 md:px-8 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div data-reveal class="relative">
        <div class="overflow-hidden rounded-sm">
          <Image
            src={unsplashUrl('1630176028338-bd36cf3ed160', 1000)}
            width={1000}
            height={1250}
            alt="Hand opening the door of a polished black luxury car"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="absolute -bottom-6 -right-6 hidden rounded-sm border border-accent/40 bg-bg px-8 py-6 shadow-xl sm:block">
          <p class="font-display text-3xl font-semibold text-accent">24/7</p>
          <p class="text-sm text-muted">Reservations &amp; dispatch</p>
        </div>
      </div>

      <div>
        <p data-reveal class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">
          Why 1Limo
        </p>
        <h2 data-reveal style="transition-delay: 50ms" class="mt-3 font-display text-3xl font-semibold text-text md:text-4xl">
          More than a limousine company
        </h2>

        <dl class="mt-10 space-y-8">
          {
            differentiators.map((item, index) => (
              <div data-reveal style={`transition-delay: ${100 + index * 75}ms`} class="border-l-2 border-accent/40 pl-6">
                <dt class="font-display text-lg font-semibold text-text">{item.title}</dt>
                <dd class="mt-1.5 text-muted leading-relaxed">{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <TestimonialsSection />

  <!-- Service areas -->
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-6 text-center md:px-8">
      <p data-reveal class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">
        Where We Drive
      </p>
      <h2 data-reveal style="transition-delay: 50ms" class="mx-auto mt-3 max-w-2xl font-display text-3xl font-semibold text-text md:text-4xl">
        Proudly serving the entire DFW Metroplex
      </h2>

      <div class="mt-12 flex flex-wrap justify-center gap-4">
        {
          serviceAreas.map((area, index) => (
            <a
              href={`/service-areas/${area.slug}/`}
              data-reveal
              style={`transition-delay: ${100 + index * 75}ms`}
              class="rounded-sm border border-border px-6 py-3 text-sm font-semibold text-text transition-colors hover:border-accent hover:text-accent"
            >
              {area.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand />
</Layout>
