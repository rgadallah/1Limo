---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTABand from '../../components/CTABand.astro';
import { serviceAreas } from '../../data/business';
import { unsplashUrl } from '../../lib/unsplash';
import { withBase } from '../../lib/site';
---

<Layout
  title="Service Areas | Chauffeured Transportation Across DFW | 1Limo"
  description="1Limo provides chauffeured transportation across Dallas, Fort Worth, Plano, and the greater DFW Metroplex."
  path="/service-areas/"
>
  <section class="border-b border-border bg-surface py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6 text-center md:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-accent">Service Areas</p>
      <h1 class="mt-3 font-display text-4xl font-semibold text-text sm:text-5xl">
        Serving the Entire DFW Metroplex
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        One standard of chauffeured transportation, wherever you're starting from — Dallas, Fort Worth, Plano, and
        everywhere in between.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 md:px-8">
      <div class="grid gap-8 sm:grid-cols-2">
        {
          serviceAreas.map((area, index) => (
            <a
              href={withBase(`/service-areas/${area.slug}/`)}
              data-reveal
              style={`transition-delay: ${(index % 2) * 100}ms`}
              class="group block overflow-hidden rounded-sm border border-border bg-surface transition-colors hover:border-accent/60"
            >
              <div class="relative h-56 overflow-hidden">
                <Image
                  src={unsplashUrl(area.imageId, 900, 600)}
                  width={900}
                  height={600}
                  alt={area.imageAlt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/10 to-transparent" />
              </div>
              <div class="p-6">
                <h2 class="font-display text-xl font-semibold text-text group-hover:text-accent">{area.name}</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">{area.heroBlurb}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
                  Learn more
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand />
</Layout>
