# Copy this file to .env (local dev) and set the same values in your host's
# environment variable settings for production builds. Any var prefixed with
# PUBLIC_ is exposed to client-side JS (needed for the fetch() form submit),
# so never put secrets in a PUBLIC_ var.

# Where the lead-capture form (src/components/LeadForm.astro) submits to.
# Point this at whatever backend you land on, e.g.:
#   Web3Forms:  https://api.web3forms.com/submit
#   Formspree:  https://formspree.io/f/your-form-id
#   A Cloudflare Worker / Netlify Function / your own endpoint: its URL
# Leave empty during early development — the form will show a "not configured"
# notice instead of silently failing.
PUBLIC_FORM_ENDPOINT=

# Web3Forms-style backends need an access key sent in the form body. If your
# chosen provider needs a public key/token like this, put it here; otherwise
# leave empty and remove the corresponding field in LeadForm.astro.
PUBLIC_FORM_ACCESS_KEY=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to skip
# loading GTM entirely (no blank/broken snippet shipped to production).
PUBLIC_GTM_ID=

# Google Ads conversion ID + label for the lead-form "thank you" conversion
# event, e.g. AW-123456789 and AbC-D_efG-h12i34J. Leave empty to skip.
PUBLIC_GOOGLE_ADS_CONVERSION_ID=
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
